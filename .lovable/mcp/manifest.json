{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "abotalal-platform-mcp",
      "version": "0.1.0",
      "title": "ابوطلال للدعاية والإعلان والتسويق الإلكتروني MCP"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List active marketing/advertising services offered by ابوطلال للدعاية والإعلان والتسويق الإلكتروني.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max services to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_packages",
        "title": "List packages",
        "description": "List active promotional packages (Gold, Diamond, Silver) with pricing and features.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "type": {
              "description": "Filter by package type (e.g. 'gold', 'diamond', 'silver').",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_ai_tools",
        "title": "List AI tools",
        "description": "List active AI tools and models curated on ابوطلال للدعاية والإعلان والتسويق الإلكتروني.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter (chat, image, video, audio, text, code, other).",
              "type": "string"
            },
            "featured_only": {
              "description": "If true, return only featured tools.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_news",
        "title": "List news ticker items",
        "description": "List active news ticker announcements published on ابوطلال للدعاية والإعلان والتسويق الإلكتروني.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
