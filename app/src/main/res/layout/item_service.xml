<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp" android:cardCornerRadius="14dp" android:cardElevation="3dp">
    <LinearLayout android:id="@+id/serviceCard" android:layout_width="match_parent" android:layout_height="150dp" android:orientation="vertical" android:padding="14dp" android:gravity="bottom">
        <TextView android:id="@+id/serviceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" android:gravity="right" />
        <TextView android:id="@+id/serviceDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#E8EEF9" android:textSize="12sp" android:gravity="right" android:maxLines="3" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
