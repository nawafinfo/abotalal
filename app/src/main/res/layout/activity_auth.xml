<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:padding="20dp" android:layoutDirection="rtl">
    <TextView android:id="@+id/authTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="ابوطلال" android:textColor="@color/primaryDark" android:textSize="30sp" android:textStyle="bold" android:gravity="center" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/authSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="الدعاية والإعلان والتسويق الإلكتروني" android:textColor="#475569" android:textSize="15sp" android:gravity="center" app:layout_constraintTop_toBottomOf="@id/authTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/authTabs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="28dp" app:layout_constraintTop_toBottomOf="@id/authSubtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/authForm" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/authTabs" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الاسم الكامل" android:inputType="textPersonName" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="البريد الإلكتروني" android:inputType="textEmailAddress" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="كلمة المرور" android:inputType="textPassword" />
        <com.google.android.material.button.MaterialButton android:id="@+id/submitAuth" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textAllCaps="false" android:textSize="16sp" />
        <ProgressBar android:id="@+id/authProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
